{
  "name": "@mofeng2223/dsh-claude-provider",
  "version": "0.4.1",
  "description": "Custom Claude provider support for DeepSeek Harness 0.1.2-alpha",
  "author": "mofeng2223",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoFeng2223/dsh-claude-provider.git"
  },
  "homepage": "https://github.com/MoFeng2223/dsh-claude-provider#readme",
  "bugs": {
    "url": "https://github.com/MoFeng2223/dsh-claude-provider/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "claude",
    "anthropic"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-settings-models": "0.1.2-alpha.5"
  }
}
